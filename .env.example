# Frontend URL for local development
VITE_API_BASE_URL=http://localhost:8080

# Backend
SERVER_PORT=8080
# Relative paths resolve from the backend working directory unless an absolute path is supplied.
# For repository-root data folder, run backend from repository root with the backend jar/classpath,
# or set APP_STORAGE_ROOT to an absolute Windows path such as C:\\Users\\YourName\\video-ai-generator\\data.
APP_STORAGE_ROOT=../data

# Configure only after a provider and endpoint are verified.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
